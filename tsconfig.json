{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    // TypeScript 6 deprecated `baseUrl` and now requires `paths`
    // values to be relative (leading `./`). Under
    // `"moduleResolution": "bundler"` they resolve from the
    // tsconfig file itself, so this is equivalent to the old
    // `baseUrl: "."` + `src/lib/*` form.
    "paths": {
      "$lib/*": ["./src/lib/*"]
    },
    // Node types are needed by a small number of test files that
    // read source via `node:fs` / `node:path` for source-level
    // regression-guard assertions (e.g. `Layout.test.ts` asserts
    // that `<UpdateBanner />` is invoked in the markup). The
    // runtime app code doesn't use Node APIs — Vitest does.
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte"]
}

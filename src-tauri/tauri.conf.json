{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bifrost",
  "version": "0.0.7",
  "identifier": "io.github.valknarr.bifrost",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bifrost",
        "width": 960,
        "height": 900,
        "minWidth": 720,
        "minHeight": 600,
        "decorations": true,
        "resizable": true,
        "backgroundColor": "#04060a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: https://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Multi-rider session manager for EVE Frontier",
    "longDescription": "Bifrost orchestrates isolated EVE Frontier game clients + per-rider Brave Browser profiles + EVE Vault wallets for multi-rider play. Uses Sandboxie (Plus or Classic) under the hood. Strictly official-APIs-only.",
    "copyright": "© 2026 Bifrost contributors. MIT licensed.",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3ODFCNjlBNUJDQjgzMzUKUldRMWc4dGJtcmFCbDloWi9iQ0E5cnExNnoycDlWOFNHRnNKZFZyVnh4WUw0L3Z5OGM3Mk14cy8K",
      "endpoints": [
        "https://github.com/valknarr/bifrost/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
